# Integration Test Environment Variables
# Copy this file to .env.test-integration and fill in your test credentials
# This file is gitignored - never commit real credentials!

# Cognito Test Account (must exist in the DEV Cognito pool: ap-southeast-1_OyLXCWR59)
# Note: These are plain environment variables (not VITE_ prefixed)
# They are read in Node test environment, not exposed to browser bundle
COGNITO_TEST_EMAIL=your-test-account@example.com
COGNITO_TEST_PASSWORD=your-test-account-password

# Enable data-modifying tests (create/update/delete user data)
# WARNING: Set to "true" only in isolated test environments where it's safe to modify data
# Default: false (tests that modify data will be skipped)
# Once enabled, tests will:
# - Create test profiles in Enrolment Service
# - May update or delete existing test data
# - Require REAL test account credentials
INTEGRATION_OPT_IN_MODIFY_DATA=false

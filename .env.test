# Test Environment Variables
# Safe values for CI/CD unit tests - no real credentials

# API Configuration
# Use a test-only API base URL that won't cause real network calls
VITE_API_BASE_URL=http://localhost:9999

# App Configuration
VITE_APP_NAME=IDP English Test
VITE_APP_VERSION=0.1.0

# Feature Flags
VITE_ENABLE_ANALYTICS=false

# Cognito Configuration (Test Taker Pool)
# Using placeholder test credentials - safe for CI tests
VITE_COGNITO_USER_POOL_ID=us-test-1_TESTUSERPOOLID
VITE_COGNITO_USER_POOL_CLIENT_ID=TESTUSERPOOLCLIENTID
VITE_COGNITO_REGION=us-test-1
VITE_COGNITO_DOMAIN=test-domain.auth.us-test-1.amazoncognito.com
VITE_REDIRECT_SIGN_IN=http://localhost:5173/auth/callback
VITE_REDIRECT_SIGN_OUT=http://localhost:5173/

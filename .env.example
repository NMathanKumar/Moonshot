# API Configuration
# DEV: Points to Enrolment Service (AWS API Gateway)
# LOCAL: Set to http://localhost:5173 for local mock development
VITE_API_BASE_URL=http://localhost:5173

# App Configuration
VITE_APP_NAME=IDP English Test
VITE_APP_VERSION=0.1.0

# Feature Flags
VITE_ENABLE_ANALYTICS=false

# Cognito Configuration (Test Taker Pool)
# Credentials must be provided via environment-specific config files (.env.development, .env.production)
# Do not commit actual credentials to .env.example
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=
VITE_COGNITO_REGION=ap-southeast-1
VITE_COGNITO_DOMAIN=
VITE_REDIRECT_SIGN_IN=http://localhost:5173/auth/callback
VITE_REDIRECT_SIGN_OUT=http://localhost:5173/
